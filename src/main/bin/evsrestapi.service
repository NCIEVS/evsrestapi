[Unit]
Description=EVS Restapi
After=network-online.target

[Service]
User=evsuser
Group=evsuser
# JAVA_HOME is selected by the launcher and shared config/setenv.sh (Java 25).
ExecStart=/local/content/evsrestapi/evsrestapi/bin/evsrestapi start
ExecStop=/local/content/evsrestapi/evsrestapi/bin/evsrestapi stop
WorkingDirectory=/local/content/evsrestapi/evsrestapi/bin
Type=forking
#Restart=always
Restart=on-failure

[Install]
WantedBy=multi-user.target
